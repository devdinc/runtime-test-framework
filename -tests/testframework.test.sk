devdinc test "assert true passes":
    assert true: {_none} is not set

devdinc test "assert false passes":
    assert false: {_none} is set
    
devdinc test "framework internal consistency":
    without halting assert true: size of all tests > 0
    without halting assert true: "%current script%" is set
    assert true: size of test errors is 0

devdinc test "assert true failure is recorded":
    without halting assert true with no error message: {_none} is set
    assert true: size of test errors is 1
    
devdinc test "assert error message is stored":
    without halting assert true with no error message "msg1": {_none} is set
    assert true with message "check failed": test errors contains "msg1"

devdinc test "no error message produces empty suffix":
    without halting assert true with no error message: {_none} is set
    assert true: size of test errors is 1

devdinc test "halting assert stops execution":
    assert true with no error message: {_none} is set
    broadcast "<red>ERROR: this should never execute"

devdinc test "without halting continues execution":
    without halting assert true with no error message: {_none} is set
    assert true: {_none} is not set

devdinc test "fail test records error":
    without halting fail test with no error message
    assert true: size of test errors is 1

devdinc test "fail test halts by default":
    fail test with no error message
    broadcast "<red>ERROR: fail test did not halt"

devdinc test "autorun flag is true":
    if event-test is not autorun:
        stop
    assert true: event-test is autorun

devdinc test "manual run flag is false" when {_none} is set:
    fail test
    
devdinc test "manual run flag" when event-test is not autorun:
    fail test if event-test is autorun

devdinc test "stop auto execution works":
    if event-test is not autorun:
        stop
    stop auto test execution here
    broadcast "<red>ERROR: auto execution not stopped"

devdinc test "all tests returns this test":
    set {_all::*} to all tests with test name "all tests returns this test"
    assert true: size of {_all::*} > 0

devdinc test "all tests":
    set {_all::*} to all tests
    assert true: size of {_all::*} > 0

devdinc test "errors do not leak between tests A":
    without halting assert true with no message: {_none} is set
    assert true: size of test errors is 1

devdinc test "errors do not leak between tests B":
    assert true: size of test errors is 0

devdinc test "event-test returns correct name":
    assert true: event-test[0] is event-string
    
devdinc test "last test result A":
    fail test with no error message
    
devdinc test "last test result B":
    set {_test::*} to all tests with test name "last test result A"
    assert true: last test result of {_test::1} is a fail
